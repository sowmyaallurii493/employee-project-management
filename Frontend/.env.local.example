# Copy this file to .env.local and fill in the values.
# Do not commit .env.local to version control.

# API base URL (when you connect a backend)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# SQL Server connection (for server-side usage only, not exposed to client)
# Example: Server=localhost;Database=EmployeeProjects;User Id=sa;Password=YourPassword;TrustServerCertificate=yes;
# Or with connection string: sqlserver://localhost;database=EmployeeProjects;user=sa;password=YourPassword;trustServerCertificate=true
# DATABASE_URL=Server=localhost;Database=EmployeeProjects;User Id=sa;Password=***;TrustServerCertificate=yes
